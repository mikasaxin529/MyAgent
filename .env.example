# ===== 模型 API Key（至少配一个即可启动）=====
# DeepSeek（推荐，成本低）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 通义千问（兼容 OpenAI 接口）
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# OpenAI（可选）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ===== DevPilot 配置 =====
# 默认主模型与 fallback 模型（填 gateway 里注册的 provider 名）
DEVILOT_PRIMARY_MODEL=deepseek
DEVILOT_FALLBACK_MODEL=qwen

# 网关限流：每分钟最大请求数
DEVILOT_RPM_LIMIT=60
