# ===== 模型 API Key（至少配一个即可启动）=====
# DeepSeek（推荐，成本低）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 通义千问（兼容 OpenAI 接口）
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# OpenAI（可选）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ===== 百炼（DashScope）：仅 AI 生图与视觉审查使用，文字生成走 DeepSeek =====
# 不配 DASHSCOPE_API_KEY 时 AI 配图整链路跳过（增强不是主链路）
DASHSCOPE_API_KEY=
DASHSCOPE_IMAGE_MODEL=qwen-image-3.0-pro
# 视觉审查（VL）用模型：逐页调用多，flash 便宜；同账号亦可用
# qwen3.8-max / qwen3.7-plus / qwen3.6-flash
DASHSCOPE_VL_MODEL=qwen3.8-flash

# ===== AIDraft 配置 =====
# 默认主模型与 fallback 模型（填 gateway 里注册的 provider 名）
AIDRAFT_PRIMARY_MODEL=deepseek
AIDRAFT_FALLBACK_MODEL=qwen

# 网关限流：每分钟最大请求数
AIDRAFT_RPM_LIMIT=60
