<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ meta.title }}{% if meta.periods and meta.periods > 1 %} · 第{{ period }}课时{% endif %}</title>
<style>{{ include_css() }}</style>
</head>
<body>
<div class="progress"></div>
<div class="deck">
{% for slide in slides %}
  <section class="slide{% if slide.kind == 'cover' or slide.kind == 'end' %} cover{% endif %}{% if slide.kind == 'cover' and slide._bg_src %} has-bg{% endif %}" id="{{ slide.id }}">
    {% if slide.kind == 'cover' and slide._bg_src %}<div class="cover-bg" style="background-image:url('{{ slide._bg_src }}')"></div><div class="cover-shade"></div>{% endif %}
    {% if slide.kind == 'toc' %}
    <div class="toc-wrap">
      <div class="toc-figure{% if slide._toc_img %} has-img{% endif %}"{% if slide._toc_img %} style="background-image:url('{{ slide._toc_img }}')"{% endif %}>
        <div class="toc-word">目 录</div><div class="toc-en">CONTENTS</div>
      </div>
      <div class="toc-list">
        {% for item in slide._toc_entries %}<div class="toc-item"><i>{{ '%02d'|format(loop.index) }}</i><span>{{ item }}</span></div>{% endfor %}
      </div>
    </div>
    {% else %}
    {% if slide.kind not in ['cover','end'] %}
    {% if slide._num_header %}{{ slide._num_header|safe }}{% else %}<div class="title-bar">
      <span>{{ slide.title }}</span>
      {% if meta.periods and meta.periods > 1 %}<span class="period-tag">第 {{ slide.period|default(1) }} 课时</span>{% endif %}
    </div>{% endif %}
    {% endif %}
    {% if slide.kind == 'cover' %}
      <div class="cover-title">{{ slide.title }}</div>
      <div class="cover-sub">{{ meta.textbook }} · {{ meta.lessonType }}</div>
      {% if meta.periods and meta.periods > 1 %}<div class="cover-period">第 {{ slide.period|default(1) }} 课时</div>{% endif %}
    {% endif %}
    <div class="content">
    {% for el in slide.elements %}
      {{ render_element(el)|safe }}
    {% endfor %}
    </div>
    {% endif %}
  </section>
{% endfor %}
</div>

<div class="nav">
  <button class="prev">◀ 上一页</button>
  <span class="counter">1 / {{ slides|length }}</span>
  <button class="next">下一页 ▶</button>
</div>

<script>{{ include_js() }}</script>
</body>
</html>
